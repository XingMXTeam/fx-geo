# GEO 闭环系统 · 后续接 key 的位置（只列名，不写值；真实值不要提交进仓库）
# 复制为 .env 后由 collectors / 启动脚本加载，或直接 export 到环境。

# Google Search Console：OAuth token 文件路径（重授权后放回此路径）
GSC_TOKEN_PATH=~/.config/mcp-gsc/token.json
GSC_OAUTH_CLIENT_SECRETS_FILE=~/.config/gsc-mcp/client_secrets.json

# AI 采样（geo citations / 自研 runner 读环境变量，只许经安全录入注入）
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Elmo（部署在 Mac / VPS 时用）
OPENROUTER_API_KEY=
SCRAPE_TARGETS=
BRIGHTDATA_API_KEY=

# Bing Webmaster（AI Performance CSV 手工导入时无需 key；API 接入时再补）
BING_WEBMASTER_API_KEY=
